# PayFast merchant credentials (from the client's PayFast account).
# Copy this file to .env for local development — never commit real values.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=

# Optional: only set this if the client's PayFast account has a
# "Payment Confirmation" passphrase enabled under Settings > Integration.
PAYFAST_PASSPHRASE=

# Set to "true" for PayFast sandbox/test credentials, "false" (or omit) for live/production.
PAYFAST_SANDBOX=false
